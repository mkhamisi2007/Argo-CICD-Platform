# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real values.

aws_region   = "us-east-1"
cluster_name = "argo-cicd-cluster"

# Must be an existing Route 53 public hosted zone you control.
hosted_zone_name = "m-khamisi.com"
app_hostname     = "app.m-khamisi.com"

waf_enabled   = true
ecr_repo_name = "argo-cicd-app"

node_instance_type = "t3.medium"
node_min_size      = 2
node_max_size      = 5

# Slack incoming webhook used for CI/CD and alert notifications.
slack_webhook_url = "https://hooks.slack.com/services/REPLACE/ME/NOW"
